{
  "schema_version": 1,
  "platform_family": "Cisco Business 250 Series Smart Switches",
  "authority": "Cisco official documentation; family-level until live-bound to exact SKU/firmware",
  "limits": {
    "active_vlans": 255,
    "mst_instances": 8,
    "pvst_instances": 126,
    "rapid_pvst_instances": 126,
    "lag_groups": 4,
    "active_ports_per_lag": 8,
    "dynamic_lag_candidates": 16,
    "igmp_multicast_groups": 255,
    "ipv4_static_routes": 32,
    "ip_interfaces": 16,
    "acl_rules": 512,
    "hardware_qos_queues": 8,
    "mac_table_addresses": 8192,
    "jumbo_frame_bytes_max": 9000,
    "syslog_buffer_messages_min": 20,
    "syslog_buffer_messages_max": 1000,
    "syslog_buffer_default": 1000
  },
  "documented_defaults": {
    "stp_mode": "rstp",
    "syslog_buffer_severity": "informational",
    "syslog_file_severity": "errors",
    "syslog_remote_hosts": "none",
    "http_service": "enabled_factory_default",
    "https_service": "enabled_factory_default",
    "snmp_service": "disabled_factory_default",
    "telnet_service": "disabled_factory_default",
    "ssh_service": "disabled_factory_default"
  },
